# 本番はVercel Postgres（Neon）等のPostgres接続文字列を使う。
# Vercelダッシュボードでプロジェクトに Postgres を追加すると、
# DATABASE_URL は自動的に環境変数として注入される。
# ローカル開発では docker などで立てたPostgresを指定する。
DATABASE_URL="postgresql://user:password@localhost:5432/miyadai"

# マイグレーション用の直接接続URL（プーリングを経由しない接続先）。
# Vercel + Neon では DATABASE_URL_UNPOOLED が自動で用意されるため設定不要。
# ローカル開発ではDBが1つしかないので、DATABASE_URL と同じ値を入れておけばよい。
DATABASE_URL_UNPOOLED="postgresql://user:password@localhost:5432/miyadai"

# シラバス全件同期(cron)を保護するシークレット。
# Vercel Cron Jobsは CRON_SECRET を環境変数に設定すると、
# 実行時に Authorization: Bearer <CRON_SECRET> ヘッダーを自動付与する。
# ローカルでcronエンドポイントを手動確認する場合も同じ値を使う。
CRON_SECRET="適当なランダム文字列に置き換える"

# ログインセッションの署名に使うシークレット。
# `openssl rand -hex 32` 等で生成したランダム文字列を設定する。
# 値を変更すると既存のログインセッションは全て無効になる。
SESSION_SECRET="適当なランダム文字列に置き換える"

# パスワードを忘れた利用者に仮パスワードを発行する管理者APIを保護するシークレット。
# `openssl rand -hex 32` 等で生成する。CRON_SECRETとは別の値にすること。
# 未設定の場合、仮パスワード発行APIは常に401を返す（＝機能が無効になる）。
ADMIN_SECRET="適当なランダム文字列に置き換える"

# Google AdSenseの広告ユニットID（ホーム画面用）。
# adsbygoogle.js自体はlayout.tsxで既に読み込んでいるが、
# 実際に広告を表示するにはAdSense管理画面で広告ユニットを作成し、
# そこで発行される data-ad-slot の値をここに設定する必要がある。
# 未設定の間は広告が非表示になるだけで、アプリの動作には影響しない。
NEXT_PUBLIC_ADSENSE_SLOT_HOME=""
