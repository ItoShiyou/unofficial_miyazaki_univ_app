generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // 通常のクエリはコネクションプーリング経由（サーバーレスでは接続数を抑える必要があるため）
  url      = env("DATABASE_URL")
  // マイグレーションはプーリング経由だと失敗するため、直接接続のURLを使う。
  // Vercel+Neonでは DATABASE_URL_UNPOOLED が自動で用意される。
  // ローカル開発では DATABASE_URL と同じ値を .env に設定しておけばよい。
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// 学外公開シラバスから取得した授業カタログ（大学・学期ごと）
model SyllabusCourse {
  id          String   @id @default(uuid())
  university  String   @default("miyazaki-u") // @/lib/universities の id
  year        Int
  semester    String // "前期" | "後期" | "通年"
  code        String? // 講義コード（大学ごとのシラバス検索の講義コード。差分検知の同一性判定に使用）
  name        String
  teacher     String?
  room        String?
  weekday     String? // 月〜日
  period      Int?
  division    String? // 講義分類（学部・学科・プログラム等）
  syllabusUrl String?
  rawHash     String? // 差分検知用の内容ハッシュ
  fetchedAt   DateTime @default(now())
  attendanceHint      String?  // シラバス「履修上の注意」欄から抽出した出席・欠席関連の記述
  attendanceHintFetchedAt DateTime? // 上記を取得済みかどうかの判定用（null=未取得）

  kartes  CourseKarte[]
  changes SyllabusChange[]
  cancellationReports CancellationReport[]

  @@index([university, year, semester, name])
  @@index([university, year, semester, code])
}

// 「今日休講速報」：学期に1回しか行わないシラバス自動同期（休講・教員変更等の
// 恒久的な変更検知）とは別に、「今日この授業は休講かもしれない」という
// その日限りの一次情報を学生同士で共有するための crowd-sourced 機能。
// 東洋大学等の実例では大学公式アプリが当日リアルタイムで休講通知を配信しており、
// 本アプリの学期1回の同期ではこの即時性のあるニーズに応えられていないと
// 実データレビューで判明したため、匿名の自己申告を集約する形で補う。
// サイクル104・111の教訓（1人の連打が複数人の報告に見えてしまう）を踏まえ、
// 最初からユーザーごとに1日1回までの制約をDBのunique制約で持たせる。
model CancellationReport {
  id               String        @id @default(uuid())
  syllabusCourseId String
  syllabusCourse   SyllabusCourse @relation(fields: [syllabusCourseId], references: [id], onDelete: Cascade)
  date             String // "YYYY-MM-DD"（サーバー側のローカル日付、その日限りの報告のため時刻は持たない）
  userId           String
  createdAt        DateTime      @default(now())

  @@unique([syllabusCourseId, date, userId])
  @@index([syllabusCourseId, date])
}

// シラバス差分（教員変更等）の検知ログ
model SyllabusChange {
  id               String   @id @default(uuid())
  syllabusCourseId String?
  syllabusCourse   SyllabusCourse? @relation(fields: [syllabusCourseId], references: [id])
  university       String   @default("miyazaki-u") // @/lib/universities の id
  courseName       String
  year             Int
  semester         String
  field            String // 例: "teacher", "schedule", "removed"
  oldValue         String?
  newValue         String?
  detectedAt       DateTime @default(now())

  // 匿名の授業カルテと同じく、この変更検知自体にも「本当にその通りだったか」の
  // 裏付けが無い（自動抽出・自己申告任せという業界共通の弱点）。実際にその授業を
  // 見た学生が1タップで裏付けを追加できるようにし、投稿の信頼性を後付けで補強する。
  confirmCount Int @default(0) // 「今日も同じ内容でした」
  refuteCount  Int @default(0) // 「もう変わっていました」

  votes SyllabusChangeVote[]

  @@index([syllabusCourseId])
  @@index([university, year, semester])
}

// 実データレビューで、confirmCount/refuteCountの投稿がレート制限（IPごと1時間30回）
// のみで、同一ユーザーが何度でも押せてしまう（1人の連打が複数人の裏付けに見えてしまう）
// 問題が判明したため、ユーザーごとに1回までの制約をDBのunique制約で持たせる。
model SyllabusChangeVote {
  id               String        @id @default(uuid())
  syllabusChangeId String
  syllabusChange   SyllabusChange @relation(fields: [syllabusChangeId], references: [id], onDelete: Cascade)
  userId           String
  agree            Boolean // true="今日も同じ内容でした" / false="もう変わっていました"
  createdAt        DateTime      @default(now())

  @@unique([syllabusChangeId, userId])
}

// 授業カルテ（匿名の一次情報）
model CourseKarte {
  id                 String   @id @default(uuid())
  syllabusCourseId   String
  syllabusCourse     SyllabusCourse @relation(fields: [syllabusCourseId], references: [id])
  university         String   @default("miyazaki-u") // @/lib/universities の id
  year               Int
  semester           String
  attendanceMethod   String? // 出席確認方法
  attendanceStrictness Int?  // 1-5 出席の厳しさ
  assignmentVolume   Int?    // 1-5 課題の多さ
  examFormat         String? // 試験形式
  examDifficulty     Int?    // 1-5 試験の難易度
  clarity            Int?    // 1-5 授業の分かりやすさ
  // 実データレビューで、「みんなのキャンパス」「Penmark」とも出席・課題・試験難易度の
  // 個別評価に加え、それらを統合した「楽単度」を直接聞く項目を持つ一方、本アプリには
  // 総合指標が無いという明確な抜けが判明したため追加した。
  overallEasiness    Int?    // 1-5 総合的な楽単度（単位の取りやすさ）
  atmosphere         String? // 授業の雰囲気
  pace               String? // 授業の進行速度
  advice             String? // 受講生へのアドバイス
  comment            String? // 自由コメント（実際に受けてみてどうだったか）
  createdAt          DateTime @default(now())

  // 匿名投稿ゆえの誹謗中傷リスクへの対策。一定数の通報が集まった投稿は
  // 自動的に非表示にし、運営が確認するまでの間の被害を抑える。
  // ただし実データレビューにより、報告数だけの自動非表示は集団による
  // 悪意ある通報（brigading）で正当な投稿も消せてしまう既知の弱点と判明したため、
  // (1) 通報時に理由カテゴリを必須化し、(2) 非表示は「運営確認待ちの一時的な保留」として
  // 扱い、管理者が`/api/admin/karte`で内容を確認のうえ復元・削除を判断できるようにする。
  reportCount   Int      @default(0)
  reportReasons String[] @default([])
  hidden        Boolean  @default(false)

  reports KarteReport[]

  @@index([syllabusCourseId])
}

// 実データレビューで、サイクル104のconfirm/refute連打問題と同種の欠陥として、
// 通報APIが同一ユーザーの連打を防ぐ制約を持たず（IPごとの緩いレート制限のみ）、
// HIDE_THRESHOLD(3件)がレート制限の上限(10回/時)より小さいため、1人の連打だけで
// 正当な投稿を不当に非表示化できてしまうと判明したため、ユーザーごとに1回までの
// 制約をDBのunique制約で持たせる。
model KarteReport {
  id            String      @id @default(uuid())
  courseKarteId String
  courseKarte   CourseKarte @relation(fields: [courseKarteId], references: [id], onDelete: Cascade)
  userId        String
  reason        String
  createdAt     DateTime    @default(now())

  @@unique([courseKarteId, userId])
}

// アカウント（メールアドレス＋パスワードでのログイン必須化）
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  university   String // @/lib/universities の id
  displayName  String?
  createdAt    DateTime @default(now())

  // パスワードを忘れた利用者に運営が発行する仮パスワードの状態。
  // メール送信基盤がないため、運営が本人確認のうえ発行し、本人へ直接伝える運用。
  mustChangePassword    Boolean   @default(false) // 仮パスワードでのログイン中はtrue
  tempPasswordExpiresAt DateTime? // 仮パスワードの有効期限（過ぎたらログイン不可）
}

// 超軽量ヒアリング（1問アンケート）。長文アンケートは回答率が低いため、
// 「使い続けたいと思いますか？」1問＋任意コメントのみに絞る。
// アカウント作成から一定期間経過後（実際に使ってみた実感が伴ってから）に
// マイページで1度だけ表示し、回答済みなら二度と出さない。
model AppSurveyResponse {
  id        String   @id @default(uuid())
  userId    String   @unique
  score     Int // 1〜5（「使い続けたいと思いますか？」への回答）
  comment   String?
  createdAt DateTime @default(now())
}

// 友達連携（アカウント同士を招待コードで接続）
// DBのカラム名はアカウント導入前の deviceId のまま（@mapで維持）だが、
// 実際に入る値はログイン中のUser.id。識別はサーバー側のセッションから導出し、
// クライアントから送られてきた値は信用しない。
model Friend {
  id           String   @id @default(uuid())
  userId       String   @map("deviceId")
  friendUserId String   @map("friendDeviceId")
  friendName   String
  createdAt    DateTime @default(now())

  @@unique([userId, friendUserId])
}

// 招待コード（アカウントが発行し、相手が入力して友達登録）
model InviteCode {
  code        String   @id
  userId      String   @map("deviceId")
  displayName String
  createdAt   DateTime @default(now())
  expiresAt   DateTime
}

// 友達と共有する時間割スナップショット（アカウントごとに最新を保持）
model SharedTimetable {
  userId      String   @id @map("deviceId")
  displayName String
  data        String // JSON文字列 [{weekday, period, name}]
  updatedAt   DateTime @updatedAt
}

// 地域協賛枠（宮崎県内の企業・店舗）。
// 学生からは課金せず、この協賛枠を収益源とする。広告ではなく
// 「学生生活で使える地元のお店・企業の情報」として提示する。
model Sponsor {
  id          String   @id @default(uuid())
  name        String // 店舗・企業名
  category    String // "カフェ" | "飲食" | "書店" | "美容" | "スポーツ" | "企業" 等
  description String // 一言紹介
  offer       String? // 学生向け特典（例: "学生証提示で10%オフ"）。無くても掲載可
  url         String? // 公式サイト・SNS等へのリンク
  imageUrl    String? // ロゴ・写真
  area        String? // 宮崎県内のエリア（例: "木花" "橘通り"）
  isActive    Boolean  @default(true) // 協賛期間終了後はfalseにして非表示
  sortOrder   Int      @default(0) // 表示順（手動調整用）
  startsAt    DateTime @default(now())
  endsAt      DateTime? // 協賛期間の終了日（nullなら無期限）
  createdAt   DateTime @default(now())

  // 将来、協賛企業へ掲載効果を示すための簡易計測。
  // 表示のたびにimpressionCountを、詳細リンクのクリックのたびにclickCountを加算する。
  // ただしCTR(クリック数/表示回数)は表示形式に対して一般的に低くなる指標のため、
  // 協賛企業向けの効果訴求には使わず、管理者内部のトリアージ用途に限定する
  // （実データレビューで確認。詳細は docs/autonomous_improvement_log.md サイクル10参照）。
  impressionCount Int @default(0)
  clickCount      Int @default(0)

  // 協賛企業向けのクーポンコード。学生がコードを開封（コピー）した回数=codeRevealCountは、
  // 単なるクリックより購入・来店意図の強い行動のため、協賛企業への効果説明にはこちらを主指標とする
  couponCode      String? // 例: "MIYADAI10"
  codeRevealCount Int     @default(0)

  // QR導線（チラシ・ポスター等に印刷したQRコード）経由の流入計測。
  // impressionCount(アプリ内表示)とは別に、「オフラインの導線がどれだけ機能したか」を
  // 協賛企業に示すための指標。/sponsors?qr=<id> へのアクセス時にのみ加算する。
  qrScanCount Int @default(0)

  // 協賛企業・店舗が開催するイベント（提案5「複数大学イベント枠」の実装）。
  // 時間割データをサーバーに送らない設計のため、個々の学生の空きコマを
  // 厳密に突き合わせる「マッチング」はできない。代わりに、Sponsorモデルが
  // もともと特定の大学に紐付かない設計であることを活かし、県内のどの大学の
  // 学生からも同じイベント情報が見える、という緩やかな合流の場を提供する。
  eventLabel String? // イベント名（例: "県内大学交流会" "OB訪問イベント"）。nullなら通常の協賛枠のまま
  eventAt    DateTime? // 開催日時

  stamps    SponsorStamp[]
  eventRsvps EventRsvp[]

  @@index([isActive, sortOrder])
}

// イベントへの申込・来場記録。ビジコンの検証計画（Gate B「単発の場に、三者の価値が
// あるか」）が測定項目に挙げる「申込・来場」をアプリ上で記録するための仕組み。
// 現状のSponsorモデルは1レコードにつき同時に1件のイベントしか持てない設計のため、
// 「どの回のイベントか」はsponsorIdだけで一意に定まる（新しいイベントを立てる際は
// 前のeventAtを上書きするため、過去分のRSVPは自動的に古いイベントの記録として残る）。
model EventRsvp {
  id          String    @id @default(uuid())
  userId      String
  sponsorId   String
  sponsor     Sponsor   @relation(fields: [sponsorId], references: [id], onDelete: Cascade)
  checkedIn   Boolean   @default(false) // 「来場しました」の自己申告チェックイン
  checkedInAt DateTime?
  createdAt   DateTime  @default(now())

  // イベント終了後アンケート（満足度1〜5・任意コメント）。checkedIn済みのユーザーのみ回答可能
  // （来場していない申込に対する回答を防ぎ、Gate Bで見たい「実際に来場した人の声」を守るため）。
  feedbackRating  Int? // 1〜5
  feedbackComment String?
  feedbackAt      DateTime?

  @@unique([userId, sponsorId])
  @@index([sponsorId])
}

// 「地元スタンプ帳」：協賛店舗のクーポンを開封するたびに、利用者ごとに1つ記録する
// (同じ店舗を何度開封しても増えない、集める楽しさのための1店舗1スタンプ設計)。
// 協賛企業側には、クリック・開封数以上に「実際に何人の学生と接点を持てたか」という
// 人数ベースの指標を渡せる。学生には、地元を歩く具体的な理由を作る。
model SponsorStamp {
  id          String   @id @default(uuid())
  userId      String
  sponsorId   String
  sponsor     Sponsor  @relation(fields: [sponsorId], references: [id], onDelete: Cascade)
  collectedAt DateTime @default(now())

  @@unique([userId, sponsorId])
  @@index([userId])
}

// シラバス変更（教員変更・休講等）をブラウザのプッシュ通知で届けるための購読情報。
// 1台の端末＝1レコード（同じユーザーが複数端末で購読することも想定し、userIdでは一意にしない）。
model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  endpoint  String   @unique
  p256dh    String // Push APIの暗号化鍵
  auth      String // Push APIの認証シークレット
  createdAt DateTime @default(now())

  @@index([userId])
}

// 「この授業のシラバス変更を通知してほしい」という利用者の意思表示。
// 時間割そのもの（曜日・時限・メモ等）はサーバーに送らない設計を維持しつつ、
// 変更通知の対象を絞り込むために、シラバス由来の授業IDだけをサーバー側に持つ。
model WatchedCourse {
  id               String   @id @default(uuid())
  userId           String
  syllabusCourseId String
  createdAt        DateTime @default(now())

  @@unique([userId, syllabusCourseId])
  @@index([syllabusCourseId])
}

// 宮崎県内企業からの求人・インターン・説明会の掲示板。
// 実データ検証（docs/pivot_story.md 9-1節）に基づき、職業安定法上の
// 職業紹介事業（学生と企業を「あっせん」する行為）には該当しない、
// 募集情報等提供（Wantedly等と同じ位置づけ）としての設計に徹する：
// - 企業が掲載するのみ・学生は閲覧するのみ（アプリ内での応募・マッチングは行わない）
// - 応募は必ず外部の応募先URLを通じて学生自身が行う（applicationUrlは必須）
// - 学生のプロフィール・個人情報を企業側へ提供する機能は持たない
//
// 給与等の金額を断定的に記載しない運用（containsSalaryFigure）は、Wantedlyの実例に
// ならった編集方針であり、これ自体が上記の法的区分を左右するものではない（実データ
// レビューで、募集情報等提供か職業紹介事業かの分岐は「あっせん（マッチング・仲介）
// 行為の有無」であり、給与表示の有無ではないと判明。マイナビ・リクナビ等の
// 求人情報提供事業者は給与額を通常表示している）。過大なリスク回避よりも、実際の
// 法的要件である2022年職業安定法改正（募集情報等提供事業者への正確表示義務・
// 苦情処理体制整備の努力義務）への対応を優先すべき（後者は未実装、要対応）。
model JobPosting {
  id             String    @id @default(uuid())
  companyName    String // 企業・団体名
  industry       String? // 業種
  jobType        String // 職種／プログラム名（例: "営業職" "サマーインターン" "会社説明会"）
  postingType    String   @default("job") // "job"(求人) | "internship"(インターン) | "info_session"(説明会)
  description    String // 仕事内容・実施内容
  location       String? // 就業場所・実施場所
  employmentType String? // 雇用形態（正社員／インターン／アルバイト等）。金額の断定的記載は避ける運用とする
  workPeriod     String? // 就業期間・実施期間
  targetGrade    String? // 対象学年・学部
  applicationUrl String // 応募先の外部URL（必須。アプリ内応募機能は持たない）
  deadline       DateTime? // 応募締切
  area           String? // 宮崎県内のエリア（Sponsorモデルと同様の粒度）
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())

  // Sponsorモデルと同じ理由（実データレビュー済み）で、表示回数・クリック数を
  // 計測する。ただし本モデルは学生の個人情報を一切扱わないため、
  // 協賛モデルより計測項目は最小限にとどめる。
  impressionCount Int @default(0)
  clickCount      Int @default(0)

  // 将来の収益化に備えたフラグ。実データレビューにより、みやざきインターンシップNAVI・
  // 大学キャリアセンターの実例では企業への課金は行われておらず、この規模では
  // 「掲載無料＋注目掲載を有料オプション化」（Indeedのスポンサー求人と同じ形）が
  // 唯一実例のあるモデルだと判明した。現時点では決済機能を持たず、掲載を目立たせる
  // 表示順の優遇のみに使う（課金導線自体は将来の判断事項）。
  featured Boolean @default(false)

  @@index([isActive, sortOrder])
}
